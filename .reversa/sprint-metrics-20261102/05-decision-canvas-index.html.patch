+    // trendBadge(atual, anterior, {risk:true}) -> HTML
+    function trendBadge(cur, prev, opts) {
+      const risk = opts && opts.risk;
+      if (cur === null || cur === undefined || prev === null || prev === undefined) return '';
+      const c = Number(cur), p = Number(prev);
+      if (Number.isNaN(c) || Number.isNaN(p)) return '';
+      const delta = c - p;
+      const base = Math.abs(p) > 0 ? Math.abs(delta / p) * 100 : (Math.abs(delta) > 0 ? 100 : 0);
+      if (base < 5) {
+        return '<span class="ml-1 px-1.5 py-0.5 rounded bg-slate-700/60 text-slate-300 text-[10px]">Estável ⚪</span>';
+      }
+      const up = delta > 0;
+      if (risk) {
+        return up
+          ? '<span class="ml-1 px-1.5 py-0.5 rounded bg-rose-950/70 text-rose-300 text-[10px]">Pior 🔴</span>'
